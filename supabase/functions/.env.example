# Local secrets for edge functions. Copy to supabase/functions/.env
# (never commit .env). In production: `supabase secrets set KEY=value`.
# SUPABASE_URL and the Supabase API keys are injected automatically.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
REVENUECAT_WEBHOOK_AUTH=choose-a-long-random-string
